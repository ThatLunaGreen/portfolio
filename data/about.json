ze":17,"fontWeight":400,"fontStyle":"normal","lineHeight":37.4,"color":"#171717","align":"left"},{"id":"luna-ye-54","name":"Luna Ye","type":"text","x":-240,"y":200,"width":150,"height":41,"rotation":-90,"opacity":1,"visible":true,"text":"Luna Ye","fontFamily":"Caveat","fontSize":30,"fontWeight":400,"fontStyle":"normal","lineHeight":37.2,"color":"#000000","align":"left"},{"id":"ai-native-marketer-55","name":"AI native\nmarketer","type":"text","x":280,"y":270,"width":170,"height":128,"rotation":0,"opacity":1,"visible":true,"text":"Growth \nMarketer","fontFamily":"RenathaSignature","fontSize":50,"fontWeight":400,"fontStyle":"normal","lineHeight":61,"color":"#E5007D","align":"left"},{"id":"creator-storyteller-57","name":"Creator &\nstoryteller","type":"text","x":160,"y":770,"width":205,"height":114,"rotation":-20,"opacity":1,"visible":true,"text":"Creator \n& storyteller","fontFamily":"RenathaSignature","fontSize":45,"fontWeight":400,"fontStyle":"normal","lineHeight":54,"color":"#E5007D","align":"left"},{"id":"ai-automation-builder-58","name":"AI automation\nbuilder","type":"text","x":-370,"y":720,"width":130,"height":182,"rotation":5,"opacity":1,"visible":true,"text":"AI \nautomation \nbuilder","fontFamily":"RenathaSignature","fontSize":40,"fontWeight":400,"fontStyle":"normal","lineHeight":59,"color":"#E5007D","align":"left"}]}]},{"id":"content-scale-about-i-m-luna-an-ai-native-marketing-strategis-65","name":"Content · i-m-luna-an-ai-native-marketing-strategis-65","type":"group","x":351,"y":1068,"width":731,"height":757,"rotation":0,"opacity":1,"visible":true,"scaleX":1,"scaleY":1,"children":[{"id":"i-m-luna-an-ai-native-marketing-strategis-65","name":"I'm Luna, an AI-native marketing strategis","type":"text","x":540,"y":-750,"width":465,"height":757,"rotation":0,"opacity":1,"visible":true,"text":"I'm Luna, an AI-native marketing strategist and creative consultant based in Melbourne. I work across brand, growth and human insight, turning complex products and projects into clear positioning, practical go-to-market strategies and sustainable content systems.\n\nI'm at my best when the brief is messy, the product is unfamiliar and the way forward isn't obvious. I like finding the pattern in the noise: understanding the people, clarifying the story and building a workable plan. Sometimes that means researching a new market. Sometimes it means creating an AI workflow, dashboard or agent.\n\nMy experience spans healthcare, FMCG, fashion and emerging AI products, across Chinese and international markets. I'm drawn to the complexity of people, their ambitions, hesitations and contradictions. That curiosity helps me ask better questions and make marketing feel more human.\n\nThere's a line from Virginia Woolf's The Waves that has stayed with me: “I am rooted, but I flow.” She's one of my favourite writers, and this line captures something of how I work: rooted in a curiosity about people, and open to wherever a good question might lead.","fontFamily":"Arapey","fontSize":20,"fontWeight":400,"fontStyle":"italic","lineHeight":29,"color":"#171717","align":"left"}]},{"id":"content-scale-about-i-m-at-my-best-when-the-brief-is-messy-th-66","name":"Content · i-m-at-my-best-when-the-brief-is-messy-th-66","type":"group","x":118.10000000000001,"y":1606,"width":499.8,"height":1,"rotation":0,"opacity":1,"visible":true,"scaleX":1,"scaleY":1,"children":[{"id":"i-m-at-my-best-when-the-brief-is-messy-th-66","name":"I'm at my best when the brief is messy, th","type":"text","x":0,"y":0,"width":499.8,"height":32,"rotation":0,"opacity":1,"visible":true,"text":"","fontFamily":"Karla","fontSize":20,"fontWeight":400,"fontStyle":"normal","lineHeight":29,"color":"#171717","align":"left"}]}]},{"id":"shared-header-96","name":"Shared header","type":"group","x":0,"y":0,"width":1440,"height":115,"rotation":0,"opacity":1,"visible":true,"children":[{"id":"polish-about-nav-contact-pill","name":"Contact · transparent outlined pill","type":"rect","x":971.5,"y":46,"width":95